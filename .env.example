COMPOSE_PROJECT_NAME="smtp-api-service"


# Specify a name for the docker image. If you wish to push to a registry or the Docker hub, then the registry
# or your username should be included in this name. E.g. programster/smtp-api-service
DOCKER_IMAGE_NAME="smtp-api-service"


# Specify the environment. Either "dev" or "production"
ENVIRONMENT="dev"


# Specify the database connection details.
DB_USER=
DB_PASSWORD=
DB_NAME=


# The default account for logging in to the web interface. Accounts are identified by their email address, which
# they log in with, and where password reset links are sent. It's created when the service starts, if there's no
# account for this email address yet. An existing account is never changed, so once you've logged in (and changed
# the password, or set up two-factor authentication), changing these won't undo that. Further accounts can be added
# in the web interface.
#
# The password is never kept here. ADMIN_PASSWORD_HASH is its hash (from PHP's password_hash()), base64 encoded, so
# that the "$" signs in the hash can't be taken for variables (by Docker Compose, or by GitLab in a CI/CD variable).
# Make it with PHP, or with Docker if you don't have PHP, then type the password and press Enter. Reading the password
# from what you type keeps it out of your shell's history:
#
#   php -r 'echo base64_encode(password_hash(rtrim(fgets(STDIN), "\r\n"), PASSWORD_DEFAULT)), PHP_EOL;'
#   docker run --rm -i php:8.4-cli php -r 'echo base64_encode(password_hash(rtrim(fgets(STDIN), "\r\n"), PASSWORD_DEFAULT)), PHP_EOL;'
#
# The password should meet the default password rules: at least 12 characters, with a capital letter, a number and a
# symbol. The service can't check it against the password rules on the Settings page, as it only has its hash. It won't
# start if the hash isn't valid, or if ADMIN_PASSWORD (which an earlier version used, for the password in plain text) is
# still set.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# The address the web interface is reached at, with nothing after it, e.g. "https://smtp.example.org". It's used
# for the links in password reset emails, and for Google to send people back to after logging in (if that's switched
# on, on the Settings page). It's set here, rather than worked out from each request, as anyone can send a request
# with any Host header. It must use https, except when ENVIRONMENT=dev.
PUBLIC_URL=

# The ports on the host that the web interface/API and the SMTP server are published on. The SMTP server is always
# encrypted: 465 uses TLS from the start (implicit TLS, "SMTPS"), and 587 requires STARTTLS before logging in.
WEB_HOST_PORT=80
SMTPS_HOST_PORT=465
SUBMISSION_HOST_PORT=587


# The service's other settings (the providers email is sent through, logging in with Google, the time zone, whether a
# second factor is required, trusted proxies, the address the service's own emails are sent from, how long a client
# waits for an email to be sent, and how long emails and logs are kept) are set in the web interface, on its Settings
# and Providers pages, which keep them in config/settings.yaml. A fresh install starts with no providers: add one on
# the Providers page, and emails sent before then are queued, and sent once it's added.
#
# A setting in settings.yaml written as "${NAME}" is read from the environment variable NAME, so secrets (e.g. a
# provider's API key) can be kept out of it: add each such variable here, with any name, and restart.


# The name the SMTP server gives itself in its greeting. Defaults to the container's hostname.
SMTP_SERVER_HOSTNAME=

# The SMTP server's TLS certificate. Put these two files, in PEM format, in the ./tls folder (mounted read-only at
# /tls), and they're used without setting anything:
#   ./tls/fullchain.pem - the certificate, followed by its intermediate certificate(s).
#   ./tls/privkey.pem   - its private key, unencrypted (no passphrase).
# These are the names Let's Encrypt and certbot give them, so their files can be copied straight in. Copy the files
# themselves: certbot's "live" folder holds symlinks, which don't work once only that folder is mounted. To use
# other names, set them here, e.g. SMTP_TLS_CERT_FILE=cert.pem (with or without "./tls/" in front), and the files are
# looked for in the ./tls folder. To use another mounted folder, give full paths inside the container instead (e.g.
# /certs/cert.pem): anything starting with "/" is used as it is. Leave both empty for the names above, or set both:
# setting only one of them is refused, so a certificate is never paired with the wrong key. They're checked hourly, so a
# renewed certificate is picked up without a restart. A certificate is required, and the service won't start
# without one, except when ENVIRONMENT=dev, when a self-signed one is generated if there's none (connections are
# still encrypted, but clients have to be told not to verify the certificate).
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=


# The limits on the memory and CPU the service uses. Each is optional, and its default (shown) suits a VPS with 1 GB
# of memory and 2 vCPUs. The Server resources page (under Settings) shows what each is set to, the server's
# memory and vCPUs, and suggested values for it, and warns about values that don't fit together. Nothing is set for
# you: copy the values here, and restart. Sizes are written in M or G, e.g. "128M" or "2G".

# The largest email the SMTP server and the send endpoint will accept, in bytes. HTTP_MAX_BODY_SIZE and
# PHP_MEMORY_LIMIT must be large enough for it (the Settings page says if they aren't).
SMTP_MAX_MESSAGE_BYTES=20971520

# The largest request nginx and PHP accept. An email sent to the API is base64-encoded, which makes it a third larger.
HTTP_MAX_BODY_SIZE=40M

# The most memory one PHP process (a web or API request, an SMTP connection, or a queue worker) can use. One handling
# an email holds several copies of it.
PHP_MEMORY_LIMIT=128M

# How many queue workers send the emails to the providers. Each keeps its connections to the providers open between
# emails, so a few can send hundreds of emails a second (within the rate limits).
QUEUE_WORKERS=4

# Limits on how much runs at once: the most PHP-FPM processes for the web interface and API, and the most SMTP
# connections at once. SMTP connections beyond that wait their turn, rather than being refused, and are handled
# as soon as one finishes (it's logged as a warning when they have to).
PHP_FPM_MAX_CHILDREN=8
SMTP_MAX_CONNECTIONS=30

# The bundled PostgreSQL (the "db" service in the compose file). DB_MEMORY_LIMIT is a hard cap on its memory. For a
# database that isn't the bundled one, set DB_MEMORY_LIMIT to what it can use if it's on this server (or leave it, if
# it's on another server, as its memory doesn't count), and set the rest in its own postgresql.conf instead. Its
# settings are written as PostgreSQL writes them, e.g. "64MB". DB_MAX_CONNECTIONS must cover two connections for each
# PHP-FPM process, queue worker and SMTP connection.
DB_MEMORY_LIMIT=384M
DB_MAX_CONNECTIONS=100
DB_SHARED_BUFFERS=64MB
DB_EFFECTIVE_CACHE_SIZE=256MB
DB_WORK_MEM=2MB
DB_MAINTENANCE_WORK_MEM=32MB


# Specify the ID and group ID of your user. You only need to specify these if you
# are developing this codebase.
HOST_USER_ID=1000
HOST_GROUP_ID=1000
