# The test stacks' settings, used by run-tests.sh in place of .env. It adds each stack's own project name, ports and
# PUBLIC_URL (so they can all run at once, alongside the development stack), any settings a stack needs changed, and
# HOST_USER_ID and HOST_GROUP_ID, from the user running it. The settings that are changed on the Settings page are in
# tests/settings.yaml.
DOCKER_IMAGE_NAME="smtp-api-service-test"
ENVIRONMENT="dev"

DB_USER="smtpapi"
DB_PASSWORD="testpassword123"
DB_NAME="smtpapi"

ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="correct-horse-battery"

SMTP_SERVER_HOSTNAME="localhost"

QUEUE_WORKERS="4"
